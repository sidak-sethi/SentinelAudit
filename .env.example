# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=false

# Strong/deep model
# Free-tier default: Groq GPT-OSS 120B
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_THINKING_LEVEL=high
LLM_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=2400

# Fast triage model - selected for high-volume throughput
# Free-tier default: Groq GPT-OSS 20B
LLM_TRIAGE_PROVIDER=groq
# Leave blank to reuse LLM_API_KEY
LLM_TRIAGE_API_KEY=
LLM_TRIAGE_MODEL=openai/gpt-oss-20b
LLM_TRIAGE_THINKING_LEVEL=low
LLM_TRIAGE_CONCURRENCY=1
LLM_TRIAGE_MAX_OUTPUT_TOKENS=400
LLM_TRIAGE_MIN_CONFIDENCE=0.80

# LLM resilience
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_RETRY_DELAY_SECONDS=60
LLM_RETRY_JITTER_SECONDS=1
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900

# NVD
NVD_API_KEY=
MAX_EVENTS_PER_PAGE=200
NVD_PAGE_DELAY_SECONDS=1.0
INITIAL_LOOKBACK_HOURS=24

# Future GitHub integration
GITHUB_TOKEN=

# Polling
POLL_INTERVAL_SECONDS=3600

# Transfer/state
OUTGOING_DIR=./data/outgoing
STATE_FILE=./data/state.json

# Source expansion
ENABLE_OSV=true
ENABLE_GITHUB_ADVISORIES=true
ENABLE_CISA_KEV=true
ENABLE_EPSS=true
# Optional comma-separated RSS/Atom/JSON feeds. Blank falls back to the built-in GitHub Security feed.
RESEARCH_SOURCE_URLS=

# Sandbox
SANDBOX_BACKEND=docker
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK=false
ALLOW_LOCAL_SANDBOX=false
RESEARCH_WORK_DIR=./data/research
