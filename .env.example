# Ollama endpoint for the local Gemma 4 model. Must be loopback unless you
# explicitly set SENTINEL_ALLOW_NON_LOOPBACK_OLLAMA=1.
OLLAMA_HOST=http://localhost:11434

# The exact Gemma 4 tag to use. Never substituted automatically -- if this
# tag is not pulled in Ollama, every AI operation fails clearly instead of
# falling back to another model.
GEMMA_MODEL=gemma4:e2b

# Maximum candidate findings returned per repository scan (1-8). Lower
# values reduce model output; increase to 8 for broader coverage.
SENTINEL_MAX_SCAN_FINDINGS=5

# Automatic patch attempts per click before reporting UNRESOLVED. The
# dashboard's Retry patch action can start another attempt.
MAX_PATCH_ATTEMPTS=1

# Optional Online threat-intelligence pipeline. Live cycles contact public
# advisory feeds and the configured LLM provider. Leave keys blank to keep
# the local repository scan workflow only.
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TRIAGE_PROVIDER=groq
# LLM_TRIAGE_API_KEY=
# LLM_TRIAGE_MODEL=openai/gpt-oss-20b
# NVD_API_KEY=
# GITHUB_TOKEN=
# SANDBOX_BACKEND=docker
# SANDBOX_NETWORK=false
# ALLOW_LOCAL_SANDBOX=false
#
# Online state, research artifacts, and exports use offline_workspace/ and
# the shared Guard outbox by default. Set SENTINEL_ONLINE_OUTBOX if you need
# to relocate the outbox; do not set OUTGOING_DIR to a separate directory.

# Optional: override where Guard/Offline read and write data. Defaults to
# ./offline_workspace relative to the project root.
# SENTINEL_WORKSPACE=./offline_workspace
# Public GitHub repositories submitted by the dashboard are shallow-cloned
# under this directory. Defaults to ./offline_workspace/repositories.
# SENTINEL_REPOSITORIES_DIR=./offline_workspace/repositories
# Append-only history of every patch attempt. Defaults to
# ./offline_workspace/patch_history.jsonl.
# SENTINEL_PATCH_HISTORY_FILE=./offline_workspace/patch_history.jsonl
